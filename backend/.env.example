# ==============================================================================
# AgriTrace Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.test for local development.
# NEVER commit real credentials, service accounts, or private keys to version control.

# Server Configuration
NODE_ENV=development
PORT=5000

# Firebase Configuration
FIREBASE_PROJECT_ID=agritrace-local
# Emulator hosts for local development (leave empty or unset in production)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Production Firebase Credentials (optional in emulator mode, required in production)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# Blockchain / EVM Configuration
# Local Hardhat node: http://127.0.0.1:8545
# Sepolia Testnet: https://eth-sepolia.g.alchemy.com/v2/your-api-key
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Chain ID: 31337 for Hardhat Local, 11155111 for Sepolia, 80002 for Polygon Amoy
CHAIN_ID=31337

# AgriTrace Deployed Smart Contract Address (Hex checksummed address)
AGRITRACE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Blockchain Confirmation & Finality Policy
# CONFIRMATION_BLOCKS: Base depth required for probabilistic confirmation (default: 2)
CONFIRMATION_BLOCKS=2
# FALLBACK_FINALITY_BLOCKS: Confirmation depth fallback when Casper FFG 'finalized' tag is unsupported (default: 5)
FALLBACK_FINALITY_BLOCKS=5
# ALLOW_FALLBACK_FINALITY: Whether fallback confirmation depth is permitted when Casper FFG 'finalized' tag is unsupported.
# Defaults to true in development/test environments (allowing local Hardhat dev nodes).
# In production, defaults to false to strictly enforce post-Merge Casper FFG cryptographic finality.
# Enabling in production requires an explicit configuration decision (ALLOW_FALLBACK_FINALITY=true).
ALLOW_FALLBACK_FINALITY=true

# CORS Configuration
# Comma-separated list of permitted browser origins for Flutter Web / Frontend
# Note: Wildcard '*' is strictly forbidden in production.
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080


